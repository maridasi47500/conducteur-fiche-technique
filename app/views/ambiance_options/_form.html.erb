<%= form_with(model: ambiance_option) do |form| %>
  <% if ambiance_option.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(ambiance_option.errors.count, "error") %> prohibited this ambiance_option from being saved:</h2>

      <ul>
        <% ambiance_option.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :style_id, style: "display: block" %>
    <%= form.select :style_id, Style.all.collect{|h|[h.name, h.id]} %>
  </div>

  <div>
    <%= form.label :category, style: "display: block" %>
    <%= form.select :category, ["machine_brouillard", "lumieres"] %>
  </div>

  <div>
    <%= form.label :value, "Valeur, exemple de valeur pour machine à brouillard: oui - continu, oui - 10 sec, ou non, et lumieres : blanc chaud, jaune, rouge, vert, bleu, stroboscope, rasant, parled, etc.", style: "display: block" %>
    <%= form.text_field :value %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
