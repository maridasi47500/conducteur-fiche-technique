<div id="<%= dom_id artistic_process %>">
  <p>
    <strong>Conducteur:</strong>
    <%= artistic_process.conducteur_id %>
  </p>

  <p>
    <strong>Initial impulse:</strong>
    <%= artistic_process.initial_impulse %>
  </p>

  <p>
    <strong>First attempt:</strong>
    <%= artistic_process.first_attempt %>
  </p>

  <p>
    <strong>Doubts questions:</strong>
    <%= artistic_process.doubts_questions %>
  </p>

  <p>
    <strong>Rejected ideas:</strong>
    <%= artistic_process.rejected_ideas %>
  </p>

  <p>
    <strong>Breakthrough:</strong>
    <%= artistic_process.breakthrough %>
  </p>

  <p>
    <strong>Final form:</strong>
    <%= artistic_process.final_form %>
  </p>

  <p>
    <strong>Iteration count:</strong>
    <%= artistic_process.iteration_count %>
  </p>

  <p>
    <strong>What changed:</strong>
    <%= artistic_process.what_changed %>
  </p>

</div>
