<tr class="conducteurline" id="<%= dom_id conducteurline %>">

  <td>
    <strong>numero:</strong>
    <%= conducteurline_counter + 1 %>
  </td>
  <td>
    <strong>Duree:</strong>
    <%= conducteurline.duree.strftime("%H:%M") rescue "00:00" %>
  </td>

  <td>
    <strong>Sequenceaction:</strong>
    <%= conducteurline.sequenceaction %>
<div class="search-actions">
      <%= link_to_google_search(conducteurline.search_query, "🔍 Google") %>
      <%= link_to_bing_search(conducteurline.search_query, "🖼️ Bing Images") %>
    </div>
  </td>

  <td>
    <strong>Interpretes:</strong>
    <%= conducteurline.interpretes %>
  </td>

  <td>
    <strong>son Fichier / Source</strong>
<%if conducteurline.son.to_s.length > 0 and File.exist?("./public/uploads/"+conducteurline.son)%>
<%= conducteurline.son%>
    <audio src="/uploads/<%= conducteurline.son %>" controls />
<%elsif conducteurline.son.to_s.length > 0%>
<%= conducteurline.son%>
<%end%>
  </td>
  <td>
    <strong>Lumieres ambiante:</strong>
    <%= conducteurline.lumieres_ambiante %>
  </td>

  <td>
    <strong>Lumieres effet:</strong>
    <%= conducteurline.lumieres_effet %>
  </td>

  <td>
    <strong>Machine brouillard:</strong>
    <%= conducteurline.machine_brouillard %>
  </td>

  <td>
    <strong>Videoprojection:</strong>
<%if conducteurline.videoprojection.to_s.length > 0 and File.exist?("./public/uploads/"+conducteurline.videoprojection)%>
    <img src="/uploads/<%= conducteurline.videoprojection %>" width=200 height=200 />
<%= conducteurline.videoprojection%>
<%elsif conducteurline.videoprojection.to_s.length > 0%>
<%= conducteurline.videoprojection%>
<%end%>
  </td>

  <td>
    <strong>Notes technicien:</strong>
    <%= conducteurline.notes_technicien %>
  </td>

</tr>
