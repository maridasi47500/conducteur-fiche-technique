
<%= form_with(model: conducteurline) do |form| %>
<table>
<tr>
  <% if conducteurline.errors.any? %>
    <td style="color: red">
      <h2><%= pluralize(conducteurline.errors.count, "error") %> prohibited this conducteurline from being saved:</h2>

      <ul>
        <% conducteurline.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </td>
  <% end %>

  <td style="display:none;">
    <%= form.hidden_field :conducteur_id %>
  </td>

  <td>
    <%= form.label :duree, style: "display: block" %>
    <%= form.time_field :duree, step: 2 %>
  </td>

  <td>
    <%= form.label :sequenceaction, "SEQUENCE - action", style: "display: block" %>
    <%= form.text_field :sequenceaction %>
  </td>

  <td>
    <%= form.label :interpretes, style: "display: block" %>
    <%= form.text_field :interpretes %>
  </td>

  <td>
    <%= form.label :son, style: "display: block" %>
    <%= form.file_field :son %>
<a href="" style="display:block;" id='buttonson1' onclick="conducteurline_son.type='text';buttonson2.style.display='block';this.style.display='none';return false;">entrer du texte pour dire ce que tu veux comme musique au lieu de donner une musique/un son à jouer </a>
<a href="" style="display:none;" id='buttonson2' onclick="conducteurline_son.type='file';buttonson1.style.display='block';this.style.display='none';return false;">donner une musique/un son à jouer au lieu de rentrer un texte pour dire ce que tu veux comme musique</a>
  </td>
  <td>
    <%= form.label :lumieres_ambiante, "lumiere ambiante (noir total, rouge, violet, jaune, mi-scene eclairee couleur, blanc doux, blanc chaud, toutes couleurs, salle rallumée)", style: "display: block" %>
<%= form.select :lumieres_ambiante, [
  ['Classiques', ["blanc chaud", "blanc doux", "salle rallumée", "plein feu"]],
  ['Couleurs', ["rouge", "violet", "jaune", "ambre", "bleu nuit", "magenta", "lavande", "toutes les couleurs"]],
  ['Technique/Scène', ["noir total", "mi-scene eclairee couleur", "douche", "contre-jour", "rasants"]]
], { include_blank: "Choisir une ambiance..." }, { class: "votre-classe-css" } %>
  </td>

  <td>
    <%= form.label :lumieres_effet, "effet de lumieres : noir, douche, effet clignotant, intensité, rasant, parled", style: "display: block" %>
    <%= form.select :lumieres_effet, ["", "scintillement", "fondu au noir", "blackout sec", "noir", "douche", "effet clignotant", "intensité", "rasant", "parled", "stroboscope"] %>
  </td>

  <td>
    <%= form.label :machine_brouillard,"oui/non/combien de secondes", style: "display: block" %>
    <%= form.text_field :machine_brouillard %>
  </td>

  <td>
    <%= form.label :videoprojection, style: "display: block" %>
    <%= form.file_field :videoprojection %>
<a href="" style="display:block;" id='buttonvideo1' onclick="conducteurline_videoprojection.type='text';buttonvideo2.style.display='block';this.style.display='none';return false;">seulement rentrer du texte pour dire ce que tu veux comme videoprojection au lieu de donner une image à regarder pour la videoprojection </a>
<a href="" style="display:none;" id='buttonvideo2' onclick="conducteurline_videoprojection.type='file';buttonvideo1.style.display='block';this.style.display='none';return false;">donner une image à voir pour la videoprojection au lieu de seulement rentrer un texte pour dire ce que tu veux comme image</a>
  </td>

  <td>
    <%= form.label :notes_technicien, "notes pour le technicien", style: "display: block" %>
    <%= form.text_area :notes_technicien %>
  </td>
  <td>
    <%= form.fields_for :conducteur_line_positions do |f|%>
<div class="field">
    <%= f.label :materiel_id, style: "display: block" %>
    <%= f.collection_select :materiel_id, Materiel.all, :id, :name %>
</div>
<div class="field">
    <%= f.label :coord_x, style: "display: block" %>
    <%= f.number_field :coord_x %>
</div>
<div class="field">
    <%= f.label :coord_y, style: "display: block" %>
    <%= f.number_field :coord_y %>
</div>
<div class="field">
    <%= f.label :transition_type, style: "display: block" %>
    <%= f.text_field :transition_type %>
</div>
    <% end %>
  </td>

  <td>
    <%= form.submit %>
  </td>
</tr>
</table>
<% end %>

