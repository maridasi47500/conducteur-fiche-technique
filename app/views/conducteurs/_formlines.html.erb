<%= form_with(model: conducteur, html: {onsubmit:"submitlines();", id: "myformconducteur"}) do |form| %>
  <% if conducteur.errors.any? %> <div style="color: red">
      <h2><%= pluralize(conducteur.errors.count, "error") %> prohibited this conducteur from being saved:</h2>

      <ul>
        <% conducteur.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

<div class="grid">
<%mycounter = 0%>
<%#=form.fields_for :conducteurlines, conducteur.conducteurlines.order(:ordre) do |f|%>
<%=form.fields_for :conducteurlines do |f|%>
<%mycounter += 1%>
<div class="item" data-index="<%=(f.object.ordre.to_i > 0 ? f.object.ordre : mycounter) rescue mycounter%>">
 <td>
    <%= mycounter %>
< ! -- déplacer ici pour changer l'ordre -->
    <%= f.hidden_field :ordre, value: mycounter %>
  </td>
 <td>
    <%= f.label :duree, style: "display: block" %>
    <%= f.time_field :duree, value: (f.object.maduree rescue "00:00:00"), step: 2 %>
  </td>

  <td>
    <%= f.label :sequenceaction, "SEQUENCE - action", style: "display: block" %>
    <%= f.text_area :sequenceaction %>
  </td>

  <td>
    <%= f.label :interpretes, style: "display: block" %>
    <%= f.text_area :interpretes %>
  </td>

  <td>
    <%= f.label :son, style: "display: block" %>
<%if (f.object and f.object.son.to_s.length > 0 and File.exist?("./public/uploads/"+f.object.son) rescue false)%>
    <%= f.file_field :son %>
<%else%>
    <%= f.text_area :son %>
<%end%>
  </td>
  <td>
    <%= f.label :lumieres_ambiante, style: "display: block" %>
    <%= f.text_field :lumieres_ambiante %>
  </td>

  <td>
    <%= f.label :lumieres_effet, style: "display: block" %>
    <%= f.text_field :lumieres_effet %>
  </td>

  <td>
    <%= f.label :machine_brouillard, style: "display: block" %>
    <%= f.text_field :machine_brouillard %>
  </td>

  <td>
    <%= f.label :videoprojection, style: "display: block" %>
<%if f.object and f.object.videoprojection.to_s.length > 0 and File.exist?("./public/uploads/"+f.object.videoprojection)%>
    <%= f.file_field :videoprojection %>
<%else%>
    <%= f.text_area :videoprojection %>
<%end%>
  </td>

  <td>
    <%= f.label :notes_technicien, style: "display: block" %>
    <%= f.text_area :notes_technicien %>
  </td>
  <td>
    <%= f.label :notes_artistique, style: "display: block" %>
    <%= f.text_area :notes_artistique %>
  </td>
  <td>
    <%= f.label :emotional_marker_id, style: "display: block" %>
    <%= f.select :emotional_marker_id, EmotionalMarker.all.collect{|f|[f.name, f.id]} %>
  </td>
  <td>
    <%= f.label :creative_notes, style: "display: block" %>
    <%= f.text_area :creative_notes %>
  </td>
  <td>
    <%= f.fields_for :conducteur_line_positions do |ff|%>
<div class="field">
    <%= ff.label :materiel_id, style: "display: block" %>
    <%= ff.collection_select :materiel_id, Materiel.all, :id, :name %>
</div>
<div class="field">
    <%= ff.label :coord_x, style: "display: block" %>
    <%= ff.number_field :coord_x %>
</div>
<div class="field">
    <%= ff.label :coord_y, style: "display: block" %>
    <%= ff.number_field :coord_y %>
</div>
<div class="field">
    <%= ff.label :transition_type, style: "display: block" %>
    <%= ff.text_field :transition_type %>
</div>
    <% end %>
  </td>

  <td>

<%= f.check_box :_destroy %>
    <%= f.label :_destroy, "supprimer cette ligne du conducteur",  style: "display: block" %>
  </td>

</div>
<%end%>
</div>

  <div>
<!--<button onclick="submitlines()" type="button">submit</button>-->
<%=form.submit%>

  </div>
<% end %>
<div id="order"></div>
