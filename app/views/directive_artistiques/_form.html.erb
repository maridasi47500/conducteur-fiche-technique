<%= form_with(model: directive_artistique) do |form| %>
  <% if directive_artistique.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(directive_artistique.errors.count, "error") %> prohibited this directive_artistique from being saved:</h2>

      <ul>
        <% directive_artistique.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :stage_theme_id, style: "display: block" %>
    <%= form.select :stage_theme_id, StageTheme.all.collect{|g|[g.name, g.id]} %>
  </div>

<div>
  <%= form.label :default_lumieres_ambiante, "Ambiance Lumineuse par Défaut", style: "display: block" %>
  <%= form.select :default_lumieres_ambiante, [
    ["--- États Standard ---", ""],
    ["Noir Total (Blackout)", "noir_total"],
    ["Plein Feu (Wash Blanc)", "plein_feu"],
    ["Salle Rallumée (Public)", "salle_rallumee"],
    ["Demi-Salle (Accueil)", "demi_salle"],
    ["--- Couleurs Chaudes ---", ""],
    ["Blanc Chaud", "blanc_chaud"],
    ["Ambre Doré", "ambre"],
    ["Rouge Sang", "rouge"],
    ["Rose / Magenta", "magenta"],
    ["Jaune Soleil", "jaune"],
    ["--- Couleurs Froides ---", ""],
    ["Blanc Doux / Froid", "blanc_doux"],
    ["Bleu Nuit", "bleu_nuit"],
    ["Bleu Cyan", "cyan"],
    ["Violet / Lavande", "violet"],
    ["Vert Émeraude", "vert"],
    ["--- Mélanges ---", ""],
    ["Toutes les couleurs (Arc-en-ciel)", "multi_couleurs"],
    ["Mi-scène éclairée (Couleur)", "mi_scene_couleur"]
  ], {}, { style: "width: 100%; padding: 5px;" } %>
</div>

<div>
  <%= form.label :default_lumieres_effet, "Effet Lumineux par Défaut", style: "display: block" %>
  <%= form.select :default_lumieres_effet, [
    ["Aucun effet", "aucun"],
    ["--- Mouvements ---", ""],
    ["Stroboscope lent", "strobo_lent"],
    ["Stroboscope rapide", "strobo_rapide"],
    ["Poursuite (Suivi)", "poursuite"],
    ["Scintillement (Effet bougie)", "scintillement"],
    ["Balayage (Scan)", "balayage"],
    ["--- Transitions ---", ""],
    ["Fondu enchaîné lent", "fade_lent"],
    ["Coupure sèche (Cut)", "cut"],
    ["--- Machines ---", ""],
    ["Brouillard léger (Haze)", "brouillard"],
    ["Fumée épaisse (Fog)", "fumee"],
    ["Étincelles (Sparkular)", "etincelles"],
    ["Bulles", "bulles"]
  ], {}, { style: "width: 100%; padding: 5px;" } %>
</div>

  <div>
    <%= form.label :default_videoprojection, style: "display: block" %>
    <%= form.text_field :default_videoprojection %>
  </div>

  <div>
    <%= form.label :default_son, style: "display: block" %>
    <%= form.text_field :default_son %>
  </div>

  <div>
    <%= form.label :default_notes_technicien, style: "display: block" %>
    <%= form.text_field :default_notes_technicien %>
  </div>

  <div>
    <%= form.label :default_sequenceaction, style: "display: block" %>
    <%= form.text_field :default_sequenceaction %>
  </div>

  <div>
    <%= form.label :default_duree, style: "display: block" %>
    <%= form.time_field :default_duree, value: directive_artistique.maduree %>
  </div>

  <div>
    <%= form.label :default_interpretes, style: "display: block" %>
    <%= form.text_field :default_interpretes %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
