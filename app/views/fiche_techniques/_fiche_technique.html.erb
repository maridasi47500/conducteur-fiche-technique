<div id="<%= dom_id fiche_technique %>">
  <p>
    <strong>Name event:</strong>
    <%= fiche_technique.name_event %>
    <%= link_to "voir la fiche technique", fiche_technique %>
  </p>

  <p>
    <strong>Eleve responsable:</strong>
    <%= fiche_technique.eleve_responsable %>
  </p>

  <p>
    <strong>Date:</strong>
    <%= fiche_technique.date %>
  </p>

  <p>
    <strong>Professeur referent:</strong>
    <%= fiche_technique.professeur_referent %>
  </p>

  <p>
    <strong>Notes complementaires:</strong>
    <%= fiche_technique.notes_complementaires %>
  </p>
  <p>
    <%= I18n.l(fiche_technique.created_at, format: :veryshort) %>
  </p>

</div>
