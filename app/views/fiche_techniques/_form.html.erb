<%= form_with(model: fiche_technique) do |form| %>
  <% if fiche_technique.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(fiche_technique.errors.count, "error") %> prohibited this fiche_technique from being saved:</h2>

      <ul>
        <% fiche_technique.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name_event, style: "display: block" %>
    <%= form.text_field :name_event %>
  </div>

  <div>
    <%= form.label :eleve_responsable, style: "display: block" %>
    <%= form.text_field :eleve_responsable %>
  </div>

  <div>
    <%= form.label :date, style: "display: block" %>
    <%= form.date_field :date %>
  </div>

  <div>
    <%= form.label :professeur_referent, style: "display: block" %>
    <%= form.text_field :professeur_referent %>
  </div>

  <div>
    <%= form.label :notes_complementaires, style: "display: block" %>
    <%= form.text_area :notes_complementaires, style: "width:100%;height:100px;" %>
  </div>
<h3>Matériel nécessaire</h3>
<div class="grid">
<%mycounter = 0%>
<%=form.fields_for :materiel_necessaires, fiche_technique.materiel_necessaires do |f|%>
<%mycounter+=1%>
<div class="item">

  <td>
    <%= f.label :materiel_id, style: "display: block" %>
    <%= f.select :materiel_id, Materiel.all.collect{|h|[h.name, h.id]} %>
  </td>

  <td>
    <%= f.label :quantite, style: "display: block" %>
    <%= f.text_field :quantite %>
  </td>

  <td>
    <%= f.label :precisions_observations, style: "display: block" %>
    <%= f.text_area :precisions_observations %>
  </td>


  <td>

<%= f.check_box :_destroy %>
    <%= f.label :_destroy, "supprimer ce materiel du matériel nécessaire",  style: "display: block" %>
  </td>



</div>
<%end%>
</div>


  <div>
    <%= form.submit %>
  </div>
<% end %>
