<%= form_with(model: fiche_technique, html: {onsubmit: "submitfichelines();", id: "myformfiche"}) do |form| %>
  <% if fiche_technique.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(fiche_technique.errors.count, "error") %> prohibited this fiche_technique from being saved:</h2>

      <ul>
        <% fiche_technique.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

<h3>plan de scene</h3>
<div class="grid">
<%mycounter = 0%>
<%=form.fields_for :plan_de_scene_dessins, fiche_technique.plan_de_scene_dessins.order(:ordre) do |f|%>
<%mycounter += 1%>
<div class="item" data-index="<%=mycounter%>">
 <td>
    <%= mycounter %>
< ! -- déplacer ici pour changer l'ordre -->
    <%= f.text_field :ordre, value: mycounter %>
  </td>

  <td>
    <%= f.label :disposition, style: "display: block" %>
    <%= f.select :disposition, ["left", "right", "center"] %>
  </td>

  <td>
    <%= f.label :materiel_musicien, "matériel / musicien", style: "display: block" %>
    <%= f.text_field :materiel_musicien %>
  </td>

  <td>
    
<%= f.check_box :_destroy %>
    <%= f.label :_destroy, "supprimer ce materiel / musicien du plan de scene",  style: "display: block" %>
  </td>



</div>
<%end%>
</div>


  <div>
<!--<button onclick="submitfichelines()" type="button">submit</button>-->
<%=form.submit%>
  </div>
<% end %>
<div id="order"></div>

