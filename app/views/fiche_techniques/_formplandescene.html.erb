<%= form_with(model: fiche_technique) do |form| %>
  <% if fiche_technique.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(fiche_technique.errors.count, "error") %> prohibited this fiche_technique from being saved:</h2>

      <ul>
        <% fiche_technique.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

<h3>plan de scene</h3>
<table>
<%=form.fields_for :plan_de_scene_dessins do |f|%>
  <tr>
  <td>
    <%= f.label :disposition, style: "display: block" %>
    <%= f.select :disposition, ["left", "right", "center"] %>
  </td>

  <td>
    <%= f.label :materiel_musicien, "matériel / musicien", style: "display: block" %>
    <%= f.text_field :materiel_musicien %>
  </td>

  <td>
    <%= f.label :ordre, style: "display: block" %>
    <%= f.text_field :ordre %>
  </td>
  <td>
    
<%= f.check_box :_destroy %>
    <%= f.label :_destroy, "supprimer ce materiel / musicien du plan de scene",  style: "display: block" %>
  </td>


  </tr>

<%end%>
</table>

  <div>
    <%= form.submit %>
  </div>
<% end %>
