<p style="color: green"><%= notice %></p>

<h1>Machine logs</h1>
<style>
body {
  background-color: #f0f2f5;
  font-family: 'Segoe UI', Helvetica, Arial, sans-serif;
  display: flex;
  justify-content: center;
  padding: 20px;
}

.fb-feed {
  width: 100%;
  max-width: 600px;
}

.fb-post {
  background: white;
  border-radius: 8px;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
  margin-bottom: 20px;
  padding: 12px 16px;
}

/* En-tête */
.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 12px;
  position: relative;
}

.user-avatar {
  width: 40px;
  height: 40px;
  background: #1877f2;
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: bold;
  margin-right: 10px;
}

.post-meta {
  display: flex;
  flex-direction: column;
}

.module-name {
  font-weight: 600;
  color: #050505;
}

.timestamp {
  font-size: 13px;
  color: #65676b;
}

/* Badges de niveau */
.log-level {
  position: absolute;
  right: 0;
  top: 0;
  padding: 4px 8px;
  border-radius: 4px;
  font-size: 11px;
  font-weight: bold;
  text-transform: uppercase;
}

.error { background: #ffebe9; color: #f02849; }
.info { background: #e7f3ff; color: #1877f2; }
.warning { background: #fff8e2; color: #f7b928; }

/* Contenu */
.post-content {
  font-size: 15px;
  color: #050505;
  line-height: 1.4;
}

.human-box {
  background: #f0f2f5;
  padding: 10px;
  border-radius: 8px;
  margin: 10px 0;
  border-left: 4px solid #1877f2;
}

.raw-data {
  font-family: monospace;
  font-size: 12px;
  background: #242526;
  color: #a8abaf;
  padding: 8px;
  border-radius: 4px;
  cursor: pointer;
}

/* Barre d'action */
.post-actions {
  border-top: 1px solid #ced0d4;
  margin-top: 12px;
  padding-top: 4px;
  display: flex;
  justify-content: space-around;
  color: #65676b;
  font-weight: 600;
  font-size: 14px;
}

.post-actions span {
  padding: 8px;
  flex: 1;
  text-align: center;
  border-radius: 4px;
  cursor: pointer;
}

.post-actions span:hover {
  background: #f2f2f2;
}
</style>

<div class="fb-feed">
  <% @machine_logs.each do |log| %>
    <div class="fb-post">
      <div class="post-header">
        <div class="user-avatar">
          <%= log.module[0..1].upcase %>
        </div>
        <div class="post-meta">
          <span class="module-name"><%= log.module %></span>
          <span class="timestamp"><%= I18n.l(log.created_at, format: :tresshort) %></span>
        </div>
        <div class="log-level <%= log.level.downcase %>">
          <%= log.level %>
        </div>
      </div>

      <div class="post-content">
        <p class="translation"><strong>Traduction :</strong> <%= log.fb_translation %></p>
        
        <div class="human-box">
          <p class="perspective"><%= log.human_perspective %></p>
        </div>

        <details class="raw-data">
          <summary>Voir les données brutes (JSON)</summary>
          <code><%= log.raw_data %></code>
        </details>
      </div>

      <div class="post-actions">
        <span>👍 J'aime</span>
        <span>💬 Commenter</span>
        <span>↩ Partager</span>
      </div>
    </div>
  <% end %>
</div>


<%= link_to "New machine log", new_machine_log_path %>
