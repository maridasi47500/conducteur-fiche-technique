<p style="color: green"><%= notice %></p>

<h1>Machine logs</h1>

<div id="machine_logs">
  <% @machine_logs.each do |machine_log| %>
    <%= render machine_log %>
    <p>
      <%= link_to "Show this machine log", machine_log %>
    </p>
  <% end %>
</div>

<%= link_to "New machine log", new_machine_log_path %>
