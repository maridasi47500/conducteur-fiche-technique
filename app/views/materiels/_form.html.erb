<%= form_with(model: materiel) do |form| %>
  <% if materiel.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(materiel.errors.count, "error") %> prohibited this materiel from being saved:</h2>

      <ul>
        <% materiel.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>
  
  <fieldset>
    <legend>Visibilité sur le plan</legend>
    
    <div class="field">
      <%= form.label :on_stage, "Afficher sur la scène ?" %>
      <%= form.check_box :on_stage %>
    </div>

    <div class="field">
      <%= form.label :zone_id, "Zone assignée" %>
      <%= form.collection_select :zone_id, Zone.all, :id, :name, prompt: "Choisir une zone" %>
    </div>
    
    <div class="field">
      <%= form.label :zone_y, "zone : back, mid ou front" %>
      <%= form.select :zone_y, ["back", "mid", "front"] %>
    </div>
    <div class="field">
      <%= form.label :default_layer, "Calque d'affichage" %>
      <%= form.select :default_layer, ["Background", "Instruments", "Câblage", "Top"] %>
    </div>
  </fieldset>

  <fieldset>
    <legend>Position sur le plan</legend>
    <div class="field">
      <%= form.label :x_pref, "position x préférée" %>
      <%= form.number_field :x_pref, min:0, max: 100 %>
    </div>
    <div class="field">
      <%= form.label :spread, "spread (espace autour)" %>
      <%= form.number_field :spread %>
    </div>
  </fieldset>
  <fieldset>
    <legend>Configuration Technique</legend>
    
    <div class="field">
      <%= form.label :requires_power, "Nécessite du courant" %>
      <%= form.check_box :requires_power %>
    </div>

    <div class="field">
      <%= form.label :maximum, "Quantité maximum autorisée" %>
      <%= form.number_field :maximum, min: 1 %>
    </div>

  </fieldset>
    <div class="field">
      <%= form.label :pic, "add a pic" %>
      <%= form.file_field :pic %>
    </div>



  <div>
  <%= form.submit "Enregistrer le matériel", class: "btn-primary" %>
  </div>
<% end %>
