<%= form_with(model: projet_artistique) do |form| %>
  <% if projet_artistique.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(projet_artistique.errors.count, "error") %> prohibited this projet_artistique from being saved:</h2>

      <ul>
        <% projet_artistique.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :fiche_technique_id, style: "display: block" %>
    <%= form.select :fiche_technique_id, FicheTechnique.all.collect{|g|[g.name_event, g.id]} %>
  </div>

  <div>
    <%= form.label :conducteur_id, style: "display: block" %>
    <%= form.select :conducteur_id, Conducteur.all.collect{|g|[g.title, g.id]} %>
  </div>

  <div>
    <%= form.label :title, style: "display: block" %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :username, style: "display: block" %>
    <%= form.text_field :username %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
