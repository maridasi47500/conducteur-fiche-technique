<p style="color: green"><%= notice %></p>


<% if @projet_artistique.status == 'processing' %>
  <div class="loader">
    <p>🎨 Nous générons votre projet artistique...</p>
    <p>Analyse de la partition et collecte des photos GPS en cours.</p>
  </div>
  <script>
    // Recharge la page toutes les 5 secondes jusqu'à ce que le statut change
    setTimeout(() => { location.reload(); }, 5000);
  </script>
<% else %>
  <h1>Votre Conducteur : <%= @projet_artistique.style %></h1>
  <%# Affichage du conducteur avec les images téléchargées %>
<%= render @projet_artistique %>
<% end %>

<div>
  <%= link_to "Edit this projet artistique", edit_projet_artistique_path(@projet_artistique) %> |
  <%= link_to "Back to projet artistiques", projet_artistiques_path %>

  <%= button_to "Destroy this projet artistique", @projet_artistique, method: :delete %>
</div>
