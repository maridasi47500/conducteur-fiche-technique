<%= form_with(model: sequence_template) do |form| %>
  <% if sequence_template.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(sequence_template.errors.count, "error") %> prohibited this sequence_template from being saved:</h2>

      <ul>
        <% sequence_template.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :label, style: "display: block" %>
