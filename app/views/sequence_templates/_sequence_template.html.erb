<div id="<%= dom_id sequence_template %>">
  <p>
    <strong>Label:</strong>
    <%= sequence_template.label %>
    (<%= sequence_template.style.name %>)
  </p>

  <p>
    <strong>Phase:</strong>
    <%= sequence_template.phase %>
  </p>

  <p>
    <strong>Target talent:</strong>
    <%= sequence_template.target_talent %>
  </p>

  <p>
    <strong>Suggested light:</strong>
    <%= sequence_template.suggested_light %>
<%= link_to "💡 Idées de lumières", "https://www.google.com/search?q=stage+lighting+ideas+#{sequence_template.style&.name}", target: "_blank" %>
  </p>

  <p>
    <strong>Intensity:</strong>
    <%= sequence_template.intensity %>
  </p>

</div>
