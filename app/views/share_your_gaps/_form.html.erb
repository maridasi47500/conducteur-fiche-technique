<%= form_with(model: share_your_gap) do |form| %>
  <% if share_your_gap.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(share_your_gap.errors.count, "error") %> prohibited this share_your_gap from being saved:</h2>

      <ul>
        <% share_your_gap.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :conducteur_id, style: "display: block" %>
    <%= form.select :conducteur_id, Conducteur.all.collect{|g|[g.title, g.id]} %>
  </div>

  <div>
    <%= form.label :analysis, "machine analysis", style: "display: block" %>
    <%= form.text_area :analysis, placeholder: "analyse de la machine, que dit la machine?", style: "width:100%;height:100px;" %>
  </div>

  <div>
    <%= form.label :response, "human response", style: "display: block" %>
    <%= form.text_area :response, style: "width:100%;height:100px;" %>
  </div>

  <div>
    <%= form.label :interpretation, "human interpretation", style: "display: block" %>
    <%= form.text_area :interpretation, placeholder: "que dit la machine qu'en pensez vous? êtes vous d'accord?", style: "width:100%;height:100px;" %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
