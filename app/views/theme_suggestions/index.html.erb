<h1>Theme suggestions</h1>

<div id="theme_suggestions">
  <% @theme_suggestions.each do |theme_suggestion| %>
    <%= render theme_suggestion %>
    <p>
      <%= link_to "Show this theme suggestion", theme_suggestion %>
    </p>
  <% end %>
</div>


